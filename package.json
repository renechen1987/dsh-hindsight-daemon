{
  "name": "dsh-hindsight-daemon",
  "version": "1.5.0",
  "description": "DSH Desktop native plugin: auto-start the local Hindsight daemon on app launch, auto-stop on quit.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": {
      "default": "./dist/client.js"
    }
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}